# Copy this file to .env for local dev, and set the same keys in
# Vercel -> Project Settings -> Environment Variables for the deployed version.

# Resend (transactional email) - resend.com, free tier
RESEND_API_KEY=
FROM_EMAIL=orders@yourdomain.com

# Where the QC email lands before anything reaches a customer
FOUNDER_EMAIL=you@example.com

# Any long random string - used to sign the order data inside the
# "Approve & send" link so no database is needed. Generate one with:
# openssl rand -hex 32
ORDER_SECRET=

# Optional: Tally -> Settings -> Integrations -> Webhooks -> "Sign requests"
# gives you a secret to paste here, so forged webhook calls are rejected.
TALLY_WEBHOOK_SECRET=

# Your deployed Vercel URL, e.g. https://shagun-backend.vercel.app
# (used to build the approve link in the QC email)
PUBLIC_BASE_URL=
